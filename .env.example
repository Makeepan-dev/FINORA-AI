# FINORA — Environment Configuration Template (Placeholders Only)
# Free-Tier AI Providers & PayPal Sandbox

# AI Configuration — STRICT ZERO-COST RULES
# Valid providers: gemini | groq | openrouter | cerebras | deterministic
AI_PRIMARY_PROVIDER=gemini
AI_MODEL=gemini-flash-lite-latest
ALLOW_PAID_MODELS=false
ALLOW_AUTO_RECHARGE=false
MAX_API_SPEND_USD=0

# Free-Tier Developer API Keys (Optional — Deterministic engine operates 100% offline)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# PayPal Configuration — Sandbox Only (Never use live credentials for hackathon demo)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_REQUIRE_WEBHOOK_VERIFICATION=true

# Single-User Session Boundary Secret (Optional override for HMAC-SHA256 session tokens)
FINORA_SESSION_SECRET=replace_with_local_random_hmac_secret

# Database (SQLite default; desktop build automatically uses %APPDATA%/FINORA/finora.db)
DATABASE_URL=sqlite:///./finora.db
