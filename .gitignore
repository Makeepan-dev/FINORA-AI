# =====================================================================
# FINORA — Git Ignore Rules (Security & Build Exclusions)
# =====================================================================

# 1. Environment Files, API Keys & Cryptographic Secrets
.env
backend/.env
desktop/.env
**/.env
.env.local
.env.*.local
!.env.example
!backend/.env.example
*.pem
*.key
*.pfx
*.p12
secrets.*

# 2. SQLite Databases & Runtime User Data (Never Commit Personal/Runtime DBs)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
finora.db
backend/finora.db

# 3. Python Virtual Environments, Caches & PyInstaller Intermediates
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg
*.manifest

# 4. Node.js Dependencies & Frontend Build Outputs
node_modules/
frontend/node_modules/
desktop/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 5. Windows Desktop Packaging & Generated Installer Binaries (GitHub Release Only)
dist/
build/
release/
out/
installer_output/
desktop/dist/
desktop/release/
desktop/backend-dist/
backend/build/
backend/dist/
*.exe
*.msi
*.blockmap
*.AppImage
*.dmg
*.zip
*.7z

# 6. Logs & Temporary Files
*.log
logs/
tmp/
temp/

# 7. Editor & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
