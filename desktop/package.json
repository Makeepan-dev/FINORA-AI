{
  "name": "finora-desktop",
  "productName": "FINORA",
  "version": "1.0.0",
  "description": "FINORA — AI-Powered Personal Financial Intelligence & Everyday Money-Saving Assistant",
  "main": "main.js",
  "author": "FINORA AI Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.finora.desktop",
    "productName": "FINORA",
    "copyright": "Copyright © 2026 FINORA AI",
    "asar": true,
    "directories": {
      "output": "../installer_output"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "error.html",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend_dist/finora-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "FINORA Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FINORA",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "FINORA Portable.exe"
    }
  }
}
